<!-- Loaded only when com.intellij.cmake is present (see plugin.xml's optional <depends>) -
     the CMake/CLion-flavoured half of this plugin's Incredibuild integration. Also compiled
     against com.intellij.clion ("Native Build Tools"), which com.intellij.cmake itself always
     brings along, for the CidrBuildTargetAction/CPPToolchains/CPPEnvironment/CPPBuildUtil family
     these actions are built on - see actions/cmake/CMakeBuildCommand.kt. -->
<idea-plugin>
    <actions>
        <!-- anchor="first" against the (so far only-a-separator) Incredibuild.Menu group
             declared in plugin.xml inserts this above that separator - Build ends up first,
             pushing anything already there down.

             Labelled "... CMake Target"/"... CMake Targets" rather than a plain
             "Build"/"Rebuild"/"Build All": when the Rust optional dependency above is *also*
             satisfied (e.g. CLion with the Rust plugin installed too), both sets of actions
             land in the same Incredibuild menu, and a bare "Build"/"Rebuild" from each would
             be indistinguishable there. -->
        <action id="Incredibuild.CMake.Build"
                class="com.incredibuild.ibplugin.actions.cmake.BuildCMakeTargetWithIncredibuildAction"
                text="Build CMake Target"
                description="Build the selected run configuration's target through Incredibuild"
                icon="/icons/incredibuild.svg">
            <add-to-group group-id="Incredibuild.Menu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action id="Incredibuild.CMake.Rebuild"
                class="com.incredibuild.ibplugin.actions.cmake.RebuildCMakeTargetWithIncredibuildAction"
                text="Rebuild CMake Target"
                description="Clean and rebuild the selected run configuration's target through Incredibuild"
                icon="/icons/incredibuild.svg">
            <add-to-group group-id="Incredibuild.Menu" anchor="after" relative-to-action="Incredibuild.CMake.Build"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action id="Incredibuild.CMake.BuildAll"
                class="com.incredibuild.ibplugin.actions.cmake.BuildAllCMakeTargetsWithIncredibuildAction"
                text="Build All CMake Targets"
                description="Build every target in the active CMake profile through Incredibuild"
                icon="/icons/incredibuild.svg">
            <add-to-group group-id="Incredibuild.Menu" anchor="after" relative-to-action="Incredibuild.CMake.Rebuild"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
